FORGE_ENV_UPDATE_BASE_URL=https://downloads.example.com/forge-env

# macOS signing / notarization
APPLE_SIGNING_IDENTITY=Developer ID Application: Example Corp (TEAMID1234)
APPLE_TEAM_ID=TEAMID1234
APPLE_API_KEY_ID=ABC123XYZ9
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
APPLE_API_KEY_PATH=/absolute/path/AuthKey_ABC123XYZ9.p8

# Windows signing
WIN_SIGN_CERT_PATH=/absolute/path/forge-env-signing.pfx
WIN_SIGN_CERT_PASSWORD=change-me

# Optional release metadata
FORGE_ENV_RELEASE_NOTES=docs/release-notes.md
